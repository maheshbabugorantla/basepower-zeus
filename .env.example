# Variable NAMES only — never real values. Copy to .env (git-ignored) and
# fill in locally; on Vercel these are already set on both projects via the
# Supabase Marketplace integration plus manually-added API keys.

# Supabase / Postgres (synced by the Vercel Supabase Marketplace integration)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Pipelines cron auth
CRON_SECRET=

# Source-specific API credentials
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=
CENSUS_API_KEY=
GOOGLE_MAPS_API_KEY=
