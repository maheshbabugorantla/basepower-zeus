  "cards": [
    { "dot": "emerald", "title": "Nothing is precomputed at the weight level", "items": ["mv_home_signals is refreshed on a schedule by core.refresh_all_scores(); it holds raw signal values and per-signal percentiles/anchors, not a weighted score", "api.homes_ranked_weighted / blockgroup_scores_weighted / home_score_breakdown compute the weighted sum live, at request time, over that already-refreshed table", "This is a deliberate M2 decision: cheap to recompute per request, but never a stale weighted score"] },
    { "dot": "cyan", "title": "Read-only role, bounded latency", "items": ["Every query runs as zeus_web_ro: SELECT/EXECUTE only, default_transaction_read_only=on, 15s role-level statement_timeout", "web/lib/db.ts additionally caps the pg Pool at statement_timeout 15s, query_timeout 20s, max 3 connections per instance", "All three routes set force-dynamic + Cache-Control: no-store; every request reflects the live database state"] },
    { "dot": "rose", "title": "Keyset pagination", "items": ["/api/top-homes pages by (score, prop_id) cursor, 50 rows/page, not offset paging", "With a block group selected the same function filters to just that block group's gate-passed homes", "Page 1 additionally calls api.homes_ranked_weighted_count once for the 'Showing 1-50 of N' total"] }
  ]
